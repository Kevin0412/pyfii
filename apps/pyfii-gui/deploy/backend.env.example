# systemd StateDirectory=pyfii-gui creates /var/lib/pyfii-gui.
PYFII_GUI_RUNTIME_DIR=/var/lib/pyfii-gui/projects

# Optional deployment-only ICP configuration. Remove this line when unused.
PYFII_GUI_DEPLOY_CONFIG=/etc/pyfii-gui/deploy.json

# Public deployments must not expose local filesystem imports.
PYFII_GUI_ENABLE_LOCAL_PROJECT_IMPORT=false

# Bound CPU-heavy work instead of accepting an unlimited in-process backlog.
# The current cache and work queues are process-local; keep one Uvicorn worker.
PYFII_GUI_PROJECT_IMPORT_JOBS=1
PYFII_GUI_PROJECT_IMPORT_QUEUE_SIZE=2
PYFII_GUI_VIDEO_EXPORT_JOBS=1
PYFII_GUI_VIDEO_EXPORT_QUEUE_SIZE=2
