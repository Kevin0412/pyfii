# Replace localhost with the public hostname before production use.
# Do not include a scheme, port or path when automatic HTTPS is wanted.
PYFII_GUI_DOMAIN=localhost

# Copy frontend/dist contents here. The caddy user must be able to traverse
# every parent directory and read every file.
PYFII_GUI_DIST_ROOT=/srv/pyfii-gui/frontend

# Keep Uvicorn bound to loopback; Caddy is the only public listener.
PYFII_GUI_BACKEND=127.0.0.1:8000
